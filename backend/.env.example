# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Credentials (optional - falls back to mock storage if unconfigured)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Aviation APIs (optional - falls back to simulated/verified schedules)
AMADEUS_CLIENT_ID=your-amadeus-key
AMADEUS_CLIENT_SECRET=your-amadeus-secret
AVIATIONSTACK_API_KEY=your-aviationstack-key

# Live Crisis & Aviation Alerts (NewsAPI / GDELT / Official Feeds)
# Free API key from https://newsapi.org/
NEWS_API_KEY=your-newsapi-key

# OpenAI API Key (for AI Travel Assistant & AI Crisis Summaries)
# Optional - falls back to deterministic rule-based safety models if unconfigured
OPENAI_API_KEY=your-openai-api-key

# ARINA AI / Elevate Team API Key (for Live AeroMate AI Concierge)
ELEVATE_TEAM_API_KEY=your-elevate-team-api-key

