# AeroMate AI Assistant Environment Configuration Example
# Copy this file or add these keys to your backend/.env file

# OpenAI API Key (Required for live GPT completions)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Selection (Optional, defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini


ELEVATE_TEAM_API_KEY=your_elevate_team_api_key_here

PORT=3000

